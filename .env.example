# Copy to .env and fill in. Restart Metro with `npx expo start -c` afterwards —
# EXPO_PUBLIC_ values are inlined at bundle time, not read at runtime.
#
# Both of these ship inside the app bundle and are meant to be public. Security
# comes from Row Level Security in the database, not from hiding the key.
# The secret / service_role key must NEVER appear here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# The WEB OAuth client ID from Google Cloud Console — NOT the iOS one, and NOT
# a secret. It ships in the bundle and is only ever compared against, never
# used to authenticate as anything: Supabase's Google provider checks that a
# signed-in user's ID token was issued for this audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# The iOS OAuth client ID — public too. The native Google SDK on iOS needs it
# at runtime; the same ID, reversed, is also app.json's `iosUrlScheme`, which
# is how the sign-in sheet hands control back to the app. Android ignores it.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# RevenueCat's TEST STORE key (Project Settings > API keys, starts with
# `test_`). Public by design, like the anon key. It simulates purchases without
# App Store / Play accounts — and RevenueCat deliberately crashes RELEASE
# builds that use it, so it can never ship by accident. Only dev builds read it.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_your_key_here

# The real per-store keys, read by release builds (preview and production).
# They exist once the App Store / Play apps are added in RevenueCat. Leave them
# empty until then: a release build without one runs fine, it just can't sell.
# EAS cloud builds don't see this file — set them as EAS environment variables.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
